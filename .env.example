VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=la-tua-chiave-anon-pubblica

# Facoltativo: servizio WMS di ortofoto da mostrare come livello alternativo
# sulla Mappa del mercato. Chiedi l'URL e il nome del layer all'ufficio SIT
# del tuo Comune o al geoportale della tua Regione (di solito espongono un
# servizio WMS pubblico con le ortofoto aggiornate del territorio).
# Se lasci questi valori vuoti, sulla mappa resta solo lo sfondo stradale.
VITE_WMS_ORTOFOTO_URL=https://geoportale-esempio.it/wms
VITE_WMS_ORTOFOTO_LAYER=nome_layer_ortofoto
VITE_WMS_ORTOFOTO_ATTRIBUTION=Ortofoto — Geoportale Regione Esempio

# Facoltativo: in alternativa (o in aggiunta) al WMS sopra, un'ortofoto pubblicata
# come ArcGIS ImageServer (usato da alcuni geoportali regionali, es. Regione Campania).
# Va indicato l'URL base del servizio ImageServer, senza /exportImage in coda.
VITE_ESRI_ORTOFOTO_URL=https://geoportale-esempio.it/server/rest/services/CARTELLA/NOME_SERVIZIO/ImageServer
VITE_ESRI_ORTOFOTO_ATTRIBUTION=Ortofoto — Geoportale Regione Esempio
